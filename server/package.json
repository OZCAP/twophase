  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "http_ece": "^1.2.1",
