# Copy to .env (never commit it) and fill in. Used by docker-compose.yml.

# Tailscale auth key (admin console → Settings → Keys). Only needed for the first start; the node's
# identity is kept in the tailscale-state volume afterwards. Prefer a reusable, pre-approved key
# with a tag (e.g. tag:twophase): tagged nodes don't expire.
TS_AUTHKEY=tskey-auth-...
# Machine name on the tailnet: https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=twophase
# Extra `tailscale up` flags, e.g. the tag the key allows:
# TS_EXTRA_ARGS=--advertise-tags=tag:twophase

# Tailnet devices allowed to use the app and approve: tags, logins or machine names, comma-separated.
ADMIN_TAILSCALE_ALLOW=tag:admin-client

# Contact address Web Push services may use.
VAPID_SUBJECT=mailto:you@example.com

# APPROVAL_TIMEOUT_SECONDS=300
# AUDIT_RETENTION_DAYS=90
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=7
