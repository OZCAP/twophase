# Copy to .env (never commit it) and fill in. Used by docker-compose.yml.

# Tailscale auth key (admin console → Settings → Keys). Only needed for the first start; the node's
# identity is kept in the tailscale-state volume afterwards. Prefer a reusable, pre-approved key
# with a tag (e.g. tag:twophase): tagged nodes don't expire.
TS_AUTHKEY=tskey-auth-...
# Machine name on the tailnet: https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=twophase
# Extra `tailscale up` flags, e.g. the tag the key allows:
# TS_EXTRA_ARGS=--advertise-tags=tag:twophase
# Port for the web app and admin API (default 443). Hosted MCP shares it unless TS_MCP_PORT is set.
# TS_HTTPS_PORT=443
# Optional: hosted MCP on its own port, e.g. 8443 gives
# https://<TS_HOSTNAME>.<tailnet>.ts.net:8443/mcp/<database> (and no MCP on TS_HTTPS_PORT)
# TS_MCP_PORT=8443

# Control who can manage the app and approve using Tailscale grants/ACLs for the HTTPS port.
# Every verified tailnet device that can reach that port has admin access.
# Optional: also require a management password. Keep it in this untracked file.
# ADMIN_PASSWORD=
# Or set ADMIN_PASSWORD_FILE to a file mounted read-only inside the container.
# Set only one of ADMIN_PASSWORD and ADMIN_PASSWORD_FILE.

# Contact address Web Push services may use.
VAPID_SUBJECT=mailto:you@example.com

# APPROVAL_TIMEOUT_SECONDS=300
# AUDIT_RETENTION_DAYS=90
