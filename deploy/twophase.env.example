# Twophase environment (see README → Configuration).
HOST=127.0.0.1
PORT=8787
DATA_DIR=/var/lib/twophase
# Admin login via the Tailscale device identity (expose with `tailscale serve`):
ADMIN_AUTH=tailscale
ADMIN_TAILSCALE_ALLOW=tag:admin-client
# Postgres clients (psql, apps): expose with `tailscale serve --tcp=6432 tcp://127.0.0.1:6432`
WIRE_HOST=127.0.0.1
WIRE_PORT=6432
# MySQL / MariaDB clients: expose with `tailscale serve --tcp=3307 tcp://127.0.0.1:3307`
MYSQL_WIRE_HOST=127.0.0.1
MYSQL_WIRE_PORT=3307
# Contact for push services (a mailto: or https: URL)
VAPID_SUBJECT=mailto:you@example.com
APPROVAL_TIMEOUT_SECONDS=300
